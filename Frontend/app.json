{
  "expo": {
    "name": "CineVerse",
    "slug": "cineverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_idea2.png",
    "scheme": "movieapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon_idea2.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030014",
        "foregroundImage": "./assets/icon_idea2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.CineVerse"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030014",
          "image": "./assets/icon_idea2.png",
          "imageWidth": 100
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39d07bdb-f4f6-4e26-bd2a-ba6423723c9b"
      }
    },
    "owner": "adarsh-dev-04s-team"
  }
}
